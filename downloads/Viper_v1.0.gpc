combo x4092   { set_rumble(RUMBLE_A, 40); wait(30); reset_rumble(); }
combo uh97c    { set_rumble(RUMBLE_A, 30); wait(20); reset_rumble(); }
combo ud9mn  { set_rumble(RUMBLE_A, 80); wait(80); reset_rumble(); wait(60); set_rumble(RUMBLE_A, 80); wait(80); reset_rumble(); }

