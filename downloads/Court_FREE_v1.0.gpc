/* ============================================================================
   Court  FREE  v1.0   |  NBA 2K26  |  Cronus Zen GPC
   FREE give-away build. Author: ZenForge / Feroz
   ----------------------------------------------------------------------------
   The free, stripped-down version of the Mamba tempo script. Single global
   auto-green release timing + shot cue only. No per-height table, no no-dip /
   quickstop / dunk / dribble / layup, no profiles, no VM overclock -> those are
   the PREMIUM (paid) script.
   Banner: stacked stretched text "COURT" / "FREE" (no baked art on free builds).
   MENU: hold L2 + tap OPTIONS/MENU.  L1/R1 = section.  LEFT/RIGHT move items.
   UP/DOWN change value.  O (CIRCLE) = save ("SETUP SAVED" 2s -> banner).
   PREMIUM section -> UP/DOWN opens "GET PREMIUM SCRIPTS - ferozzens.com".
   ============================================================================
   @ZENFORGE
   {
     "name":"Court FREE","game":"nba2k","version":"1.0","tier":"free",
     "menu_open":"HOLD L2 + OPTIONS",
     "mods":[
       {"id":0,"label":"AUTO GREEN","var":"t_green","pvar":"SPVAR_3","type":"toggle","default":1},
       {"id":1,"label":"SHOT TIMING","var":"v_tempo","pvar":"SPVAR_1","type":"value","min":0,"max":300,"default":40},
       {"id":2,"label":"SHOT CUE","var":"t_cue","pvar":"SPVAR_12","type":"toggle","default":1}
     ]
   }
   @ENDZENFORGE
   ============================================================================ */

define OUT_PC   = 0;
define OUT_PS5  = 1;
define OUT_XBOX = 2;
define OUTPUT       = OUT_PC;     // master also auto-detects the console at boot
define CFG_STAMP   = 0;
define CFG_VERSION = 1;          // bump to force a one-time re-init to current defaults on flash

define BTN_SHOOT  = PS4_SQUARE;
define BTN_SPRINT = PS4_R2;
define BTN_ADS    = PS4_L2;
define MENU_BTN   = PS4_OPTIONS;
define NAV_UP     = PS4_UP;
define NAV_DOWN   = PS4_DOWN;
define NAV_LEFT   = PS4_LEFT;
define NAV_RIGHT  = PS4_RIGHT;
define BTN_SAVE   = PS4_CIRCLE;
define RX = PS4_RX;
define RY = PS4_RY;
define LX = PS4_LX;
define LY = PS4_LY;

define ITEM_COUNT = 3;

const string TITLE    = "Court";
const string BANNER1  = "COURT";
const string BANNER2  = "FREE";
const string ITEMS[]  = { "AUTO GREEN","SHOT TIMING","SHOT CUE" };
const string ONOFF[]  = { "OFF","ON" };
const string STR_SAVED = "SETTINGS";
const string STR_SAVED2= "SAVED!";
const string SECN[]   = { "SHOOTING","PREMIUM" };
const string LOADING  = "LOADING";
const string PRM_TOP  = "GET PREMIUM";
const string PRM_URL  = "ferozzens.com";
const string PRM_L1   = "GET PREMIUM SCRIPTS";

int t_green, v_tempo, t_cue;
int menu_open, sel, nav_cd, dirty, splash_timer, banner_drawn, promo_timer, idle_cycle_t;
define IDLE_TITLE_MS = 10000;   /* normal banner shown ~10s before cycling */
define IDLE_PROMO_MS = 4000;    /* then a "GET PREMIUM" callout for ~4s, repeat */
int rel_delay, shooting, shot_timer;
int led_tmr;
int i, feat, bar_fw, j, slen_tmp, ndig, sgap, sx0;
int _idx, _div, _d, _neg;
int section, fx_tmr, booting, boot_t, star_i;
int hub_mode, hub_sel, hub_next, hub_anim, ul_w, ul_tgt, cx, tk, tw;
int star_x[16], star_y[16], star_s[16], star_sz[16];

function build_num(val) {
    _idx = 1; _neg = 0;
    if (val < 0) { val = abs(val); _neg = 1; }
    if (_neg) { putc_oled(_idx, 45); _idx = _idx + 1; }
    _div = 1;
    while (val / (_div * 10) > 0) { _div = _div * 10; }
    while (_div >= 1) { _d = (val / _div) % 10; putc_oled(_idx, _d + 48); _idx = _idx + 1; _div = _div / 10; }
    return _idx - 1;
}
function print_int_c(py, font, charw, val) { ndig = build_num(val); puts_oled((128 - ndig * charw) / 2, py, font, ndig, OLED_WHITE); }
function print_c(strp, py, font, cw)  { cx = (128 - get_slen(strp) * cw) / 2; print(cx, py, font, OLED_WHITE, strp); }
function print_cb(strp, py, font, cw) { cx = (128 - get_slen(strp) * cw) / 2; print(cx, py, font, OLED_WHITE, strp); }
function draw_tri_l(tx, cy) { for (tk = 0; tk <= 4; tk = tk + 1) { line_oled(tx + tk, cy - tk, tx + tk, cy + tk, 1, 1); } }
function draw_tri_r(tx, cy) { for (tk = 0; tk <= 4; tk = tk + 1) { line_oled(tx - tk, cy - tk, tx - tk, cy + tk, 1, 1); } }
function clampi(v, lo, hi) { if (v < lo) return lo; if (v > hi) return hi; return v; }
function get_slen(strp) { slen_tmp = 0; while (duint8(strp)) { strp = strp + 1; slen_tmp = slen_tmp + 1; } return slen_tmp; }
function press_hold(b) { return event_press(b) || (get_ival(b) && get_ptime(b) > 280 && !(get_ptime(b) % 90)); }
function apply_led() { set_rgb(255, 45, 0); }   // Mamba-line signature red-orange

function draw_stretch(strp, py) {
    slen_tmp = get_slen(strp);
    if (slen_tmp <= 1) { sgap = 0; sx0 = (128 - 8) / 2; }
    else { sgap = (118 - 8) / (slen_tmp - 1); sx0 = (128 - ((slen_tmp - 1) * sgap + 8)) / 2; }
    for (i = 0; i < slen_tmp; i = i + 1) {
        putc_oled(1, duint8(strp + i)); puts_oled(sx0 + i * sgap,     py, OLED_FONT_MEDIUM, 1, OLED_WHITE);
        putc_oled(1, duint8(strp + i)); puts_oled(sx0 + i * sgap + 1, py, OLED_FONT_MEDIUM, 1, OLED_WHITE);
    }
}
function draw_banner() {
    cls_oled(OLED_BLACK);
    draw_stretch(BANNER1[0], 12);
    draw_stretch(BANNER2[0], 38);
}
function draw_splash() {
    cls_oled(OLED_BLACK);
    draw_stars();
    print_cb(STR_SAVED[0], 15, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
    print_cb(STR_SAVED2[0], 33, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
}
function draw_promo() {
    cls_oled(OLED_BLACK);
    draw_stars();
    rect_oled(6, 8, 116, 48, 1, 0);
    print((128 - get_slen(PRM_L1[0]) * OLED_FONT_SMALL_WIDTH) / 2, 18, OLED_FONT_SMALL, OLED_WHITE, PRM_L1[0]);
    print((128 - get_slen(PRM_URL[0]) * OLED_FONT_MEDIUM_WIDTH) / 2, 34, OLED_FONT_MEDIUM, OLED_WHITE, PRM_URL[0]);
}
function draw_value(f) {
    if (f == 0)       print_c(ONOFF[t_green], 31, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
    else if (f == 1)  print_int_c(31, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH, v_tempo);
    else print_c(ONOFF[t_cue], 31, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
}
function draw_stars() {
    for (star_i = 0; star_i < 16; star_i = star_i + 1) {
        star_x[star_i] = star_x[star_i] - star_s[star_i];
        if (star_x[star_i] < 0) { star_x[star_i] = 127; star_y[star_i] = random(0, 63); }
        if (star_sz[star_i] > 1) {
            rect_oled(star_x[star_i], star_y[star_i], 2, 2, 1, 1);
        } else {
            line_oled(star_x[star_i], star_y[star_i], star_x[star_i], star_y[star_i], 1, 1);
        }
    }
}
function draw_hub() {
    cls_oled(OLED_BLACK);
    draw_stars();
    if (hub_anim == 1) { hub_sel = hub_next; hub_anim = 2; ul_w = 0; }
    if (hub_sel > 0) print_c(SECN[hub_sel - 1], 6, OLED_FONT_SMALL, OLED_FONT_SMALL_WIDTH);
    if (hub_sel < 1) print_c(SECN[hub_sel + 1], 54, OLED_FONT_SMALL, OLED_FONT_SMALL_WIDTH);
    print_cb(SECN[hub_sel], 24, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
    ul_tgt = get_slen(SECN[hub_sel]) * OLED_FONT_MEDIUM_WIDTH;
    if (ul_w != ul_tgt) ul_w = ul_tgt;
    if (ul_w > 0) {
        line_oled((128 - ul_w) / 2, 42, (128 + ul_w) / 2, 42, 1, 1);
        line_oled((128 - ul_w) / 2, 43, (128 + ul_w) / 2, 43, 1, 1);
    }
    if (hub_anim == 2) hub_anim = 0;
}
function draw_menu() {
    cls_oled(OLED_BLACK);
    draw_stars();
    feat = sec_item(section, sel);
    if (feat == -2) {
        print_cb(PRM_TOP[0], 9, OLED_FONT_SMALL, OLED_FONT_SMALL_WIDTH);
        print_c(PRM_URL[0], 31, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
        return;
    }
    tw = get_slen(ITEMS[feat]) * OLED_FONT_SMALL_WIDTH;
    print_cb(ITEMS[feat], 6, OLED_FONT_SMALL, OLED_FONT_SMALL_WIDTH);
    line_oled((128 - tw) / 2, 18, (128 + tw) / 2, 18, 1, 1);
    draw_tri_l(4, 38);
    draw_tri_r(123, 38);
    draw_value(feat);
}
function draw_loading() {
    cls_oled(OLED_BLACK);
    draw_stars();
    print((128 - get_slen(TITLE[0]) * OLED_FONT_MEDIUM_WIDTH) / 2, 10, OLED_FONT_MEDIUM, OLED_WHITE, TITLE[0]);
    print((128 - get_slen(LOADING[0]) * OLED_FONT_SMALL_WIDTH) / 2, 32, OLED_FONT_SMALL, OLED_WHITE, LOADING[0]);
    rect_oled(14, 44, 100, 8, 1, 0);
    bar_fw = (boot_t * 98) / 1000; if (bar_fw > 98) bar_fw = 98;
    if (bar_fw > 0) {
        for (j = 1; j <= 6; j = j + 1) { line_oled(15, 44 + j, 15 + bar_fw, 44 + j, 1, 1); }
    }
}
function save_all() {
    set_pvar(SPVAR_3, t_green); set_pvar(SPVAR_1, v_tempo); set_pvar(SPVAR_12, t_cue);
}
function change_value(f, dir) {
    if (f == 0) t_green = !t_green;
    else if (f == 1) v_tempo = clampi(v_tempo + dir, 0, 300);
    else t_cue = !t_cue;
}
/* ---- sectioned menu: SHOOTING / PREMIUM ---- */
function sec_count(s) { if (s == 0) return 3; return 1; }
function sec_item(s, ix) {
    if (s == 0) { if (ix == 0) return 0; if (ix == 1) return 1; return 2; }
    return -2;                                                  // PREMIUM link
}
function menu_change(dir) {
    feat = sec_item(section, sel);
    if (feat == -2) return;
    change_value(feat, dir);
}
function block_menu_buttons() {
    set_val(NAV_UP,0); set_val(NAV_DOWN,0); set_val(NAV_LEFT,0); set_val(NAV_RIGHT,0);
    set_val(PS4_CROSS,0); set_val(PS4_CIRCLE,0); set_val(PS4_SQUARE,0); set_val(PS4_TRIANGLE,0);
    set_val(PS4_L1,0); set_val(PS4_R1,0); set_val(PS4_OPTIONS,0); set_val(PS4_SHARE,0);
    set_val(BTN_ADS,0);
}

init {
    if (get_pvar(SPVAR_62, 0, 999, 0) != CFG_VERSION || get_pvar(SPVAR_61, 0, 999, 0) != CFG_STAMP) {
        set_pvar(SPVAR_62, CFG_VERSION);
        set_pvar(SPVAR_61, CFG_STAMP);
        set_pvar(SPVAR_63, 0);
    }
    if (get_pvar(SPVAR_63, 0, 1, 0) == 0) {
        set_pvar(SPVAR_63, 1);
        t_green = 1; v_tempo = 40; t_cue = 1;
        save_all();
    }
    t_green = get_pvar(SPVAR_3, 0, 1, 1);
    v_tempo = get_pvar(SPVAR_1, 0, 300, 40);
    t_cue   = get_pvar(SPVAR_12, 0, 1, 1);
    menu_open = 0; sel = 0; nav_cd = 0; dirty = 1; splash_timer = 0; banner_drawn = 0; idle_cycle_t = 0; promo_timer = 0;
    section = 0; booting = 1; boot_t = 0; fx_tmr = 0;
    for (i = 0; i < 16; i = i + 1) { star_x[i] = random(0, 127); star_y[i] = random(0, 63); star_s[i] = 1; star_sz[i] = 1 + (i % 4 == 0); }
    hub_mode = 0; hub_sel = 0; hub_next = 0; hub_anim = 0; ul_w = 0; ul_tgt = 0;
    apply_led();
    cls_oled(OLED_BLACK);
}

main {
    vm_tctrl(-9);
    led_tmr = led_tmr + get_rtime();
    if (led_tmr >= 120) { led_tmr = 0; apply_led(); }
    fx_tmr = fx_tmr + get_rtime();

    if (booting) {
        boot_t = boot_t + get_rtime();
        if (fx_tmr >= 45) { fx_tmr = 0; draw_loading(); }
        if (boot_t >= 1000) { booting = 0; banner_drawn = 0; idle_cycle_t = 0; cls_oled(OLED_BLACK); }
    } else {

    if (get_val(BTN_ADS) && event_press(MENU_BTN)) {
        if (!menu_open) { menu_open = 1; hub_mode = 1; hub_sel = section; hub_next = hub_sel; hub_anim = 0; }
        else { menu_open = 0; save_all(); }
        set_val(MENU_BTN, 0); dirty = 1; banner_drawn = 0; idle_cycle_t = 0; cls_oled(OLED_BLACK);
    }

    if (menu_open) {
        block_menu_buttons();
        if (nav_cd > 0) nav_cd = nav_cd - 1;
        if (hub_mode) {
            if (event_press(NAV_UP) && hub_anim == 0)   { hub_next = hub_sel - 1; if (hub_next < 0) hub_next = 1; hub_anim = 1; dirty = 1; combo_run(NavTick); }
            if (event_press(NAV_DOWN) && hub_anim == 0) { hub_next = hub_sel + 1; if (hub_next > 1) hub_next = 0; hub_anim = 1; dirty = 1; combo_run(NavTick); }
            if ((event_press(PS4_CROSS) || event_press(NAV_RIGHT)) && hub_anim == 0) {
                if (hub_sel == 1) { menu_open = 0; promo_timer = 3000; banner_drawn = 0; idle_cycle_t = 0; combo_run(NavTick); cls_oled(OLED_BLACK); }
                else { section = hub_sel; sel = 0; hub_mode = 0; ul_w = 0; ul_tgt = 60; dirty = 1; combo_run(NavTick); }
            }
            if (event_press(BTN_SAVE) || event_press(NAV_LEFT)) { menu_open = 0; save_all(); splash_timer = 1000; banner_drawn = 0; idle_cycle_t = 0; combo_run(SaveBuzz); cls_oled(OLED_BLACK); }
            if (dirty || fx_tmr >= 45) { fx_tmr = 0; draw_hub(); dirty = 0; }
        } else {
            if (event_press(PS4_R1)) { section = section + 1; if (section > 1) section = 0; sel = 0; ul_w = 0; ul_tgt = 60; dirty = 1; combo_run(NavTick); }
            if (event_press(PS4_L1)) { section = section - 1; if (section < 0) section = 1; sel = 0; ul_w = 0; ul_tgt = 60; dirty = 1; combo_run(NavTick); }
            if (nav_cd == 0 && event_press(NAV_LEFT))  { sel = sel - 1; if (sel < 0) sel = sec_count(section) - 1; nav_cd = 4; ul_w = 0; ul_tgt = 60; dirty = 1; combo_run(NavTick); }
            if (nav_cd == 0 && event_press(NAV_RIGHT)) { sel = sel + 1; if (sel >= sec_count(section)) sel = 0; nav_cd = 4; ul_w = 0; ul_tgt = 60; dirty = 1; combo_run(NavTick); }
            if (press_hold(NAV_UP)) {
                if (sec_item(section, sel) == -2) { menu_open = 0; promo_timer = 3000; banner_drawn = 0; idle_cycle_t = 0; combo_run(NavTick); cls_oled(OLED_BLACK); }
                else { if (get_ival(BTN_ADS)) menu_change(5); else menu_change(1); dirty = 1; combo_run(ValTap); }
            }
            if (press_hold(NAV_DOWN)) {
                if (sec_item(section, sel) == -2) { menu_open = 0; promo_timer = 3000; banner_drawn = 0; idle_cycle_t = 0; combo_run(NavTick); cls_oled(OLED_BLACK); }
                else { if (get_ival(BTN_ADS)) menu_change(-5); else menu_change(-1); dirty = 1; combo_run(ValTap); }
            }
            if (event_press(BTN_SAVE)) { save_all(); hub_mode = 1; hub_sel = section; hub_next = hub_sel; hub_anim = 0; dirty = 1; combo_run(NavTick); }
            if (ul_w < ul_tgt) ul_w = ul_tgt;
            if (dirty || fx_tmr >= 45) { fx_tmr = 0; draw_menu(); dirty = 0; }
        }
    } else {
        if (promo_timer > 0) { promo_timer = promo_timer - get_rtime(); if (fx_tmr >= 45) { fx_tmr = 0; draw_promo(); } banner_drawn = 0; idle_cycle_t = 0; }
        else if (splash_timer > 0) { splash_timer = splash_timer - get_rtime(); if (fx_tmr >= 45) { fx_tmr = 0; draw_splash(); } banner_drawn = 0; idle_cycle_t = 0; }
        else {
            /* idle screen auto-cycles: normal title banner, then a periodic
               "GET PREMIUM" callout, then back. */
            idle_cycle_t = idle_cycle_t + get_rtime();
            if (idle_cycle_t < IDLE_TITLE_MS) {
                if (!banner_drawn) { draw_banner(); banner_drawn = 1; }
            } else if (idle_cycle_t < IDLE_TITLE_MS + IDLE_PROMO_MS) {
                if (fx_tmr >= 45) { fx_tmr = 0; draw_promo(); }
                banner_drawn = 0;
            } else {
                idle_cycle_t = 0;
            }
        }

        // ---- AUTO GREEN: hold-then-auto-release at the calibrated time (+ shot cue) ----
        if (t_green) {
            if (event_press(BTN_SHOOT)) {
                shooting = 1; shot_timer = 0;
                rel_delay = clampi(v_tempo, 1, 300);
            }
            if (shooting == 1) {
                shot_timer = shot_timer + get_rtime();
                if (shot_timer < rel_delay) { set_val(BTN_SHOOT, 100); }
                else { set_val(BTN_SHOOT, 0); shooting = 2; if (t_cue) combo_run(ShotCue); }
            } else if (shooting == 2) {
                set_val(BTN_SHOOT, 0);
                if (get_ival(BTN_SHOOT) == 0) { shooting = 0; }
            }
        }
    }
    }
}

/* dedicated release cue - sharing NavTick let menu rumble cut the shot feedback short */
combo ShotCue  { set_rumble(RUMBLE_B, 70); wait(45); reset_rumble(); }
combo NavTick  { set_rumble(RUMBLE_A, 40); wait(30); reset_rumble(); }
combo ValTap   { set_rumble(RUMBLE_A, 30); wait(20); reset_rumble(); }
combo SaveBuzz { set_rumble(RUMBLE_A, 80); wait(80); reset_rumble(); wait(60); set_rumble(RUMBLE_A, 80); wait(80); reset_rumble(); }
