            if (event_press(PS4_L1)) { feroz52 = feroz52 - 1; if (feroz52 < 0) feroz52 = 1; feroz28 = 0; feroz70 = 0; feroz71 = 60; feroz30 = 1; combo_run(ferozC6); }
            if (feroz29 == 0 && event_press(ferozB7))  { feroz28 = feroz28 - 1; if (feroz28 < 0) feroz28 = ferozF21(feroz52) - 1; feroz29 = 4; feroz70 = 0; feroz71 = 60; feroz30 = 1; combo_run(ferozC6); }
            if (feroz29 == 0 && event_press(ferozB8)) { feroz28 = feroz28 + 1; if (feroz28 >= ferozF21(feroz52)) feroz28 = 0; feroz29 = 4; feroz70 = 0; feroz71 = 60; feroz30 = 1; combo_run(ferozC6); }
            if (ferozF5(ferozB5))   { if (get_ival(ferozB1)) ferozF23(5); else ferozF23(1); feroz30 = 1; combo_run(ferozC7); }
            if (ferozF5(ferozB6)) { if (get_ival(ferozB1)) ferozF23(-5); else ferozF23(-1); feroz30 = 1; combo_run(ferozC7); }
            if (event_press(ferozB9)) { ferozF18(); feroz68 = 1; feroz69 = feroz52; feroz74 = feroz69; feroz75 = 0; feroz30 = 1; combo_run(ferozC6); }
            if (feroz70 < feroz71) feroz70 = feroz71;
            if (feroz30 || feroz55 >= 45) { feroz55 = 0; ferozF16(); feroz30 = 0; }
        }
    } else {
        if (feroz53 > 0) { feroz53 = feroz53 - get_rtime(); if (feroz55 >= 45) { feroz55 = 0; ferozF24(); } feroz31 = 0; }
        else if (!feroz31) { ferozF14(); feroz31 = 1; }

        
        if (feroz16) {
            if (get_val(ferozB1)  > HAIR_GATE) set_val(ferozB1, 100);
            if (get_val(ferozB0) > HAIR_GATE) set_val(ferozB0, 100);
        }

        /* ---- FEROZ AIM ENGINE v2 -----------------------------------------
           Everything that touches the right stick posts into the accumulator
           here, then commits once at the bottom. No module overwrites another
           and the player's own input is never thrown away.                  */
        feroz33 = 0;
        if (feroz3 == 0 && get_val(ferozB1)) feroz33 = 1;
        else if (feroz3 == 1 && get_val(ferozB1) && get_val(ferozB0)) feroz33 = 1;
        else if (feroz3 == 2) feroz33 = 1;

        feroz35 = isqrt(pow(get_ival(ferozB10), 2) + pow(get_ival(ferozB11), 2));
        feroz86 = 0;
        if (feroz0 && feroz33 && feroz1 > 0) feroz86 = ferozF39(feroz35);
        ferozF40(feroz86);

        /* ---- HEAD LOCK ---------------------------------------------------
           The pad rumbles when a shot registers. That is the only real target
           confirmation a Zen ever gets - it cannot see the screen - so while
           the hit echo is alive we know we are on a body and the assist leans
           in and biases upward toward head level.

           The game's own aim assist pulls back down toward centre mass, so the
           two settle at a point higher than centre rather than climbing away.
           ferozF43 caps the total lean per engagement so that even if the
           game's assist is NOT engaged the aim cannot run off to the sky.

           Needs controller rumble left enabled on the Zen. Rumble off = no
           hit signal = HEAD LOCK simply never engages.                      */
        if (feroz96 > 0) { feroz96 = feroz96 - get_rtime(); if (feroz96 < 0) feroz96 = 0; }
        if (feroz96 == 0) feroz97 = 0;
        if (feroz95 > 0 && (get_val(ferozB0) || get_val(ferozB1)) &&
            (get_rumble(RUMBLE_A) > HL_GATE || get_rumble(RUMBLE_B) > HL_GATE)) feroz96 = HL_HOLD;

        if (feroz85 > 0) {
            feroz34 = feroz1;
            if (get_val(ferozB0)) feroz34 = feroz34 + (feroz1 / 3);
            if (feroz96 > 0) feroz34 = feroz34 + (feroz34 * ferozF41(feroz95)) / 100;
            /* GAIN: master multiplier over the whole assist. 100 = the tuned
               stock feel, so an untouched profile behaves exactly as before.
               200 doubles it - that is the ceiling, past which the orbit
               overshoots faster than the game's own assist can settle it. */
            feroz34 = (feroz34 * feroz104) / 100;
            /* angle in centi-degrees; AA SPEED now maps to a fast 1.2 - 13.2
               deg/ms orbit (~3 - 37 Hz, ~27 Hz at the default). A tight, fast
               micro shake trips the game's rotational assist harder than a
               wide slow circle, and AA_MICRO holds the radius small so the
               crosshair buzzes in place instead of visibly wandering.       */
            feroz32 = (feroz32 + (120 + feroz2 * 12) * get_rtime()) % 36000;
            feroz91 = feroz32 / 100;
            feroz92 = (feroz34 * ferozSin(feroz91) * feroz85 / 100) * AA_MICRO / 100;
            feroz93 = (feroz34 * ferozCos(feroz91) * feroz85 * AA_YSQUASH / 10000) * AA_MICRO / 100;
            if (feroz67) {
                feroz92 = (feroz92 * (100 - abs(get_val(ferozB10)))) / 100;
                feroz93 = (feroz93 * (100 - abs(get_val(ferozB11)))) / 100;
            }
            ferozF36(feroz92, feroz93);

            /* the upward lean itself - a bounded burst, not a permanent bias */
            if (feroz96 > 0 && feroz97 < ferozF43(feroz95)) {
                feroz97 = feroz97 + get_rtime();
                ferozF36(0, inv(ferozF42(feroz95)));
            }
        } else feroz32 = 0;

        /* AUTO TRACK
           ----------
           Rebuilt 2026-08-23 - on-device test found the previous ("slewed
           memory") version dragged the crosshair onward for ~220ms after
           the player released the stick, even during plain free-look with
           no intent to track anything. That drag was not a bug in the
           tuning - it was the DESIGN: the tracker fed the player's own live
           stick reading in as its target and slewed toward it, so releasing
           the stick left a decaying trail of the player's own past input.
           Any version of that idea drags, by construction, because it is
           literally built out of a copy of what the player just did.

           Checked how BraveAim/BraveAimers.com does theirs (research/
           script library, Unreal Script.gpc): their RS aim-assist options
           (BraveBooster / CircularAimAssist) are NOT derived from the
           player's stick at all - just an independent orbit added on top,
           running continuously while the trigger condition holds. Because
           it never reads the player's stick as an input, it cannot drag
           when the player lets go - there is nothing of the player's own
           motion in it to decay.

           This is that approach: a pure, independent, always-on orbit at
           full TRACK_PCT/GAIN magnitude. No stick reading, no memory, no
           decay - so it literally cannot continue moving after you stop
           moving, because it was never coupled to your movement.         */
        if (feroz11) {
            /* ambient floor: small independent orbit, same as before minus
               the TRACK_MICRO 3x boost -- just enough to not be dead silent
               in the edge case of a truly, perfectly motionless stick. */
            feroz102 = feroz12;
            if (feroz96 > 0) feroz102 = feroz102 + TRACK_HIT;
            feroz102 = (feroz102 * feroz104) / 100;

            feroz105 = (feroz105 + TRACK_ORBIT_SPD * get_rtime()) % 36000;
            feroz106 = feroz105 / 100;
            ferozF36((feroz102 * ferozSin(feroz106)) / 100,
                     (feroz102 * ferozCos(feroz106) * TRACK_YPCT) / 10000);

            /* primary driver: amplify the player's own raw stick reading
               once it clears a tiny deadzone. See TRACK_AMP_* comment
               above for the full rationale/evidence.                   */
            feroz116 = get_ival(ferozB10);
            feroz117 = get_ival(ferozB11);
            if (abs(feroz116) > TRACK_AMP_DEADZONE) ferozF36(((feroz116 * TRACK_AMP_GAIN) / 100 * feroz104) / 100, 0);
            if (abs(feroz117) > TRACK_AMP_DEADZONE) ferozF36(0, ((feroz117 * TRACK_AMP_GAIN) / 100 * feroz104) / 100);
        } else feroz105 = 0;

        /* ANTI RECOIL - centi-unit, ramped, and it backs off smoothly when
           the player is already pulling down instead of snapping on/off.    */
        if (feroz4 > 0 && get_val(ferozB0) && get_val(ferozB1)) {
            if (feroz5 == 1) { feroz40 = feroz40 + get_rtime(); if (feroz40 > 300) feroz40 = 300; feroz41 = (feroz4 * 100 * feroz40) / 300; }
            else feroz41 = feroz4 * 100;
            feroz41 = (feroz41 * ferozF3(800 / USER_ADS_V, 50, 200)) / 100;
            if (get_ival(ferozB11) > 0) feroz41 = (feroz41 * ferozF3(100 - get_ival(ferozB11) * 2, 0, 100)) / 100;
            ferozF36(0, feroz41);
        } else feroz40 = 0;

        /* BLOOM REDUCER -- see BR_* defines above for the concept/credit note.
           TEST BUILD: not wired to a menu toggle, gated only on BR_ENABLED. */
        if (BR_ENABLED && get_val(ferozB0) && get_val(ferozB1)) {
            feroz108 = get_ival(ferozB10);
            feroz109 = get_ival(ferozB11);
            feroz110 = isqrt(pow(feroz108, 2) + pow(feroz109, 2));
            if (feroz110 <= BR_DEADZONE) {
                ferozF36(inv(feroz108), inv(feroz109));
            } else if (feroz110 < 100) {
                feroz111 = (200 - ((abs(feroz109) + feroz110) / 10) * 10) * BR_STRENGTH / 200;
                feroz112 = (200 - ((abs(feroz108) + feroz110) / 10) * 10) * BR_STRENGTH / 200;
                feroz107 = (feroz107 + BR_SPEED * get_rtime()) % 36000;
                feroz113 = feroz107 / 100;
                ferozF36((feroz112 * ferozSin(feroz113)) / 100, (feroz111 * ferozCos(feroz113)) / 100);
            }
        } else feroz107 = 0;

        /* commit. AA SMOOTH is the filter pole: 0 = crisp, 100 = glass. */
        ferozF37((feroz78 * 97) / 100);


        /* RAPID FIRE - FIRE RATE is now literally shots per second.
           (The old build ran 500/rate and fired ~35% faster than the dial.)
           TEST BUILD (2026-08-23, "push it" request): dial widened 1-60 ->
           1-100 and the press-time floor DROPPED 17ms -> 5ms so the top of
           the range is no longer capped -- feroz8=100 now really is a
           10ms cycle (5ms on / 5ms off) instead of plateauing at the old
           ~29rps ceiling. The whole 1-100 range now tracks the dial almost
           exactly (feroz8=50 -> 20ms cycle -> 50rps, feroz8=100 -> 10ms
           cycle -> 100rps).
           RISK, read before raising further: 5ms is under even a 120fps
           frame (8.3ms), so at the top of the dial some presses can land
           between input samples and simply not register in-game -- this
           is the same 120fps-locked tradeoff already accepted for DROP
           SHOT (10ms) and PICKUP (7ms) elsewhere in this file, pushed one
           step further on purpose. If shots start silently dropping at
           high dial values on-device, that's this floor, not a bug.     */
        if (feroz7) {
            feroz94 = 1000 / feroz8;
            feroz36 = ferozF3(feroz94 / 2, 5, 60);
            feroz37 = ferozF3(feroz94 - feroz36, 5, 940);
            if (get_val(ferozB0)) combo_run(ferozC1);
            else combo_stop(ferozC1);
        }

        
        /* PICKUP - 7 ms on / 7 ms off, set on request 2026-08-23.
           READ BEFORE CHANGING: 7 ms is UNDER one 60 fps frame (16.7 ms) AND
           close to the 120 fps frame (8.3 ms) - this is a 120-fps-locked
           tuning, not a 60-fps-safe one. There is no per-user fps setting in
           this script, so at 60 fps some taps can land between samples and
           go unregistered - that's the console's input sampling rate, not a
           bug in the macro. If a 60 fps customer reports pickup feeling
           weak/inconsistent, that's this tradeoff - the 60-fps-safe fallback
           is 20/20 (matches Pulse v5/Orla, the fastest confirmed-safe value
           found in the 2026-08-23 competitor research, still well above our
           old 30/24).                                                       */
        if (feroz9 && feroz10 == 0 && get_val(PS4_L1) && get_val(PS4_R1)) {
            feroz38 = 7; feroz39 = 7;
            combo_run(ferozC2);
            set_val(PS4_L1, 0);
            set_val(PS4_R1, 0);
        } else if (feroz9 && feroz10 == 1 && get_val(ferozB2)) {
            feroz38 = 7; feroz39 = 7;
            combo_run(ferozC2);
        } else combo_stop(ferozC2);

        
        /* DROP SHOT = crouch-spam while the fire trigger is HELD (FIRE, or
           ADS+FIRE), the way the top sellers run it. The old build fired once
           on the press edge, so holding fire only crouched a single time. The
           combo keeps a long enough on-time that the game registers every
           crouch instead of the character just vibrating in place.          */
        if ((feroz13 == 1 && get_val(ferozB0)) || (feroz13 == 2 && get_val(ferozB0) && get_val(ferozB1))) {
            feroz22 = ferozF8(); combo_run(ferozC3);
        } else combo_stop(ferozC3);

        
        
        if (feroz18 && event_press(ferozF27())) {
            feroz20 = ferozF9(); feroz21 = ferozF10();
            set_val(ferozF27(), 0);
            combo_run(ferozC4);
        }

        
        if (feroz14) {
            if (ferozF6()) { feroz24 = 1; feroz25 = 0; }
            if (feroz24 == 1) {
                feroz25 = feroz25 + get_rtime();
                /* 30 ms assert - the 15 ms the old build used was below what
                   the game reliably registers. 30 is what every working edit
                   macro in the wild uses (Neptune, ARC, Unreal).            */
                if (feroz25 >= 2 && feroz25 < 30) ferozF7();
                else if (feroz25 >= 40) feroz24 = 0;
            }
        }
    }
    }
}

combo ferozC1    { set_val(ferozB0, 100); wait(feroz36); set_val(ferozB0, 0); wait(feroz37); }
combo ferozC2   { set_val(ferozB2, 100); wait(feroz38); set_val(ferozB2, 0); wait(feroz39); }
/* DROP SHOT test tuning (2026-08-23 request): forced to 10ms/10ms, a
   120fps-locked tempo (the same value AIM_ENGINE_V2.md flagged as the
   fallback for one customer's 120fps lock). This sits under the
   16.7ms/60fps frame time -- on a 60fps-locked pad some presses can land
   between input samples and go unregistered, same trade-off already
   documented for PICKUP (7ms) elsewhere in this file, not a new bug.     */
define DROP_ON  = 10;
define DROP_OFF = 10;
combo ferozC3     { set_val(feroz22, 100); wait(DROP_ON); set_val(feroz22, 0); wait(DROP_OFF); }

combo ferozC4 {
    set_val(feroz20, 100); wait(RESET_MS);
    set_val(feroz21, 100); wait(RESET_MS);
    set_val(feroz20, 0); set_val(feroz21, 0); wait(RESET_MS);
}
combo ferozC6   { set_rumble(RUMBLE_A, 40); wait(30); reset_rumble(); }
combo ferozC7   { set_rumble(RUMBLE_A, 30); wait(20); reset_rumble(); }
combo ferozC8   { set_rumble(RUMBLE_A, 80); wait(80); reset_rumble(); wait(60); set_rumble(RUMBLE_A, 80); wait(80); reset_rumble(); }
