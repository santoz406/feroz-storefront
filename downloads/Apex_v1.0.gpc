    }

    if (get_val(ferozB1) && get_val(ferozB3)) {
        set_val(ferozB3, 0);
        if (!feroz66) {
            feroz65 = feroz65 + get_rtime();
            if (feroz65 >= 300) {
                feroz66 = 1;
                if (!feroz27) { feroz27 = 1; feroz68 = 1; feroz69 = feroz52; feroz74 = feroz69; feroz75 = 0; feroz85 = 0; ferozF38(); }
                else { feroz27 = 0; ferozF18(); feroz31 = 0; }
                feroz30 = 1; cls_oled(OLED_BLACK);
            }
        }
    } else {
        feroz65 = 0;
        if (!get_val(ferozB3)) feroz66 = 0;
    }

    if (feroz27) {
        ferozF20();
        if (feroz29 > 0) feroz29 = feroz29 - 1;
        if (feroz68) {
            if (event_press(ferozB5) && feroz75 == 0)   { feroz74 = feroz69 - 1; if (feroz74 < 0) feroz74 = 1; feroz75 = 1; feroz30 = 1; combo_run(ferozC6); }
            if (event_press(ferozB6) && feroz75 == 0) { feroz74 = feroz69 + 1; if (feroz74 > 1) feroz74 = 0; feroz75 = 1; feroz30 = 1; combo_run(ferozC6); }
            if ((event_press(PS4_CROSS) || event_press(ferozB8)) && feroz75 == 0) { feroz52 = feroz69; feroz28 = 0; feroz68 = 0; feroz70 = 0; feroz71 = 60; feroz30 = 1; combo_run(ferozC6); }
            if (event_press(ferozB9) || event_press(ferozB7)) { feroz27 = 0; ferozF18(); feroz53 = 1000; feroz31 = 0; combo_run(ferozC8); cls_oled(OLED_BLACK); }
            if (feroz30 || feroz55 >= 45) { feroz55 = 0; ferozF31(); feroz30 = 0; }
        } else {
