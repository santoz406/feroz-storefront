main {
    vm_tctrl(-9);
    feroz42 = feroz42 + get_rtime();
    if (feroz42 >= 120) { feroz42 = 0; ferozF12(); }   
    feroz55 = feroz55 + get_rtime();

    if (feroz56) {
        feroz57 = feroz57 + get_rtime();
