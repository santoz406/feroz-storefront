        if (feroz57 >= 1000) { feroz56 = 0; feroz31 = 0; cls_oled(OLED_BLACK); }
    } else {

    
    if (!feroz27 && get_val(ferozB1) && get_val(ferozB4)) {
        set_val(ferozB4, 0);
        if (!feroz64) {
            feroz63 = feroz63 + get_rtime();
