function ferozF0(val) {
    feroz48 = 1; feroz51 = 0;
    if (val < 0) { val = abs(val); feroz51 = 1; }
    if (feroz51) { putc_oled(feroz48, 45); feroz48 = feroz48 + 1; }
    feroz49 = 1;
    while (val / (feroz49 * 10) > 0) { feroz49 = feroz49 * 10; }
    while (feroz49 >= 1) { feroz50 = (val / feroz49) % 10; putc_oled(feroz48, feroz50 + 48); feroz48 = feroz48 + 1; feroz49 = feroz49 / 10; }
    return feroz48 - 1;
}
function ferozF1(py, font, charw, val) { feroz47 = ferozF0(val); puts_oled((128 - feroz47 * charw) / 2, py, font, feroz47, OLED_WHITE); }
function ferozF32(strp, py, font, cw) { feroz73 = (128 - ferozF4(strp) * cw) / 2; print(feroz73, py, font, OLED_WHITE, strp); }
function ferozF33(strp, py, font, cw) { feroz73 = (128 - ferozF4(strp) * cw) / 2; print(feroz73, py, font, OLED_WHITE, strp); }
function ferozF34(tx, cy) { for (feroz76 = 0; feroz76 <= 4; feroz76 = feroz76 + 1) { line_oled(tx + feroz76, cy - feroz76, tx + feroz76, cy + feroz76, 1, 1); } }
function ferozF35(tx, cy) { for (feroz76 = 0; feroz76 <= 4; feroz76 = feroz76 + 1) { line_oled(tx - feroz76, cy - feroz76, tx - feroz76, cy + feroz76, 1, 1); } }
function ferozF3(v, lo, hi) { if (v < lo) return lo; if (v > hi) return hi; return v; }
function ferozSin(a) { a = a % 360; if (a < 0) a = a + 360; if (a <= 90) return SIN_Q[a]; if (a <= 180) return SIN_Q[180 - a]; if (a <= 270) return inv(SIN_Q[a - 180]); return inv(SIN_Q[360 - a]); }
function ferozCos(a) { return ferozSin(a + 90); }
/* ############################################################################
   #   FEROZ AIM ENGINE v2
   #
   #   Every module that wants to move the right stick posts a request in
   #   CENTI-UNITS (100 = one stick unit) instead of writing set_val itself.
   #   ferozF36 accumulates, ferozF37 filters and commits ONCE per tick.
   #
   #   Why this is better than the old build:
   #     * one write per tick - modules can no longer overwrite each other
   #     * additive - the player's own stick input always survives
   #     * sub-unit remainder is carried forward instead of truncated, so a
   #       0.4-unit pull becomes a smooth glide, not a 0/1 stair-step
   #     * a one-pole IIR low-pass removes the high-frequency content that
   #       aliases against the game's 60/120 Hz sampling (= the "jitter")
   ############################################################################ */
function ferozF36(cx, cy) { feroz79 = feroz79 + cx; feroz80 = feroz80 + cy; }

function ferozF37(sm) {
    feroz83 = (feroz83 * sm + feroz79 * (100 - sm)) / 100;
    feroz84 = (feroz84 * sm + feroz80 * (100 - sm)) / 100;
    feroz79 = 0; feroz80 = 0;
    feroz87 = feroz83 + feroz81;
    feroz88 = feroz84 + feroz82;
    feroz89 = feroz87 / 100;
    feroz90 = feroz88 / 100;
    feroz81 = feroz87 - feroz89 * 100;
    feroz82 = feroz88 - feroz90 * 100;
    /* v1.3 fix (2026-08-23): these used to be gated `if (feroz89 != 0)` /
       `if (feroz90 != 0)`, which SKIPPED calling set_val() entirely on any
       tick where the accumulated whole-unit delta rounded to zero -- which
       happens routinely near AUTO TRACK's own sin/cos zero-crossings, and
       for long stretches whenever the total posted magnitude is small. On
       a skipped tick the axis just holds whatever value it last had, so
       the actual HID output wasn't a continuously varying signal, it was
       a static value with periodic stutter-step jumps. That's the most
       likely reason AUTO TRACK needed a real touch to arm even after the
       magnitude fix (TRACK_MICRO) -- magnitude was never the bottleneck,
       the gaps between writes were. Calling set_val() unconditionally,
       every tick, is a no-op when feroz89/90 are 0 (re-asserts the same
       value) but guarantees the console gets a freshly-written report
       every single tick whenever any module (AA, AUTO TRACK, ANTI RECOIL,
       BLOOM REDUCER) is active -- a genuinely continuous stream instead of
       an intermittent one.                                              */
    set_val(ferozB10, ferozF3(get_val(ferozB10) + feroz89, -100, 100));
    set_val(ferozB11, ferozF3(get_val(ferozB11) + feroz90, -100, 100));
}

function ferozF38() { feroz79 = 0; feroz80 = 0; feroz81 = 0; feroz82 = 0; feroz83 = 0; feroz84 = 0; }

/* soft edge: 100 while the stick is parked, fading to 0 as the player flicks */
function ferozF39(mag) {
    /* hold below AA_RELEASE by at least 4 so the taper always has room -
       a baked AA_HOLD >= AA_RELEASE would collapse this back to a hard gate */
    feroz99 = AA_HOLD;
    if (feroz99 > AA_RELEASE - 4) feroz99 = AA_RELEASE - 4;
    if (feroz99 < 0) feroz99 = 0;
    if (mag >= AA_RELEASE) return AA_FLOOR;
    if (mag <= feroz99)    return 100;
    return AA_FLOOR + ((AA_RELEASE - mag) * (100 - AA_FLOOR)) / (AA_RELEASE - feroz99);
}

/* HEAD LOCK per-mode tuning.
     ferozF41 - assist boost, %
     ferozF42 - upward lean, centi-units (a stick RATE, so 550 = 5.5 units
                of upward camera speed while the lean is live)
     ferozF43 - how long that lean is allowed to run, ms, per engagement
   Duration is what is bounded, not accumulated magnitude - the stick is a
   rate, so a magnitude cap would have meant almost nothing.               */
function ferozF41(m) { if (m == 1) return 25;  if (m == 2) return 50;  return 80; }
function ferozF42(m) { if (m == 1) return 300; if (m == 2) return 550; return 850; }
function ferozF43(m) { if (m == 1) return 130; if (m == 2) return 170; return 220; }

function ferozF40(tgt) {
    if (feroz85 < tgt) { feroz85 = feroz85 + AA_ATTACK * get_rtime(); if (feroz85 > tgt) feroz85 = tgt; }
    else if (feroz85 > tgt) { feroz85 = feroz85 - AA_DECAY * get_rtime(); if (feroz85 < tgt) feroz85 = tgt; }
}

function ferozF4(strp) { feroz46 = 0; while (duint8(strp)) { strp = strp + 1; feroz46 = feroz46 + 1; } return feroz46; }
function ferozF5(b) { return event_press(b) || (get_ival(b) && get_ptime(b) > 280 && !(get_ptime(b) % 90)); }
function ferozF6() { return event_press(ferozF9()); }
function ferozF7() { set_val(ferozF9(), 100); }
