function ferozF15(f) {
    if (f == 0)       ferozF32(ferozS2[feroz0], 31, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH);
    else if (f == 1)  ferozF1(31, OLED_FONT_MEDIUM, OLED_FONT_MEDIUM_WIDTH, feroz1);
